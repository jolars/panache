{
  "$schema": "https://raw.githubusercontent.com/jolars/versionary/main/schemas/config.json",
  "version": 1,
  "review-mode": "pr",
  "release-type": "rust",
  "bootstrap-sha": "8b9e8a5caceb441e00b6593bd8ea87d9b60ae92b",
  "allow-stable-major": true,
  "include-commit-authors": true,
  "release-reference-comments": "best-effort",
  "packages": {
    ".": {
      "exclude-paths": [
        "crates/panache-formatter",
        "crates/panache-parser",
        "crates/panache-wasm",
        "editors",
        "docs",
        ".claude/",
        "AGENTS.md"
      ],
      "extra-files": [
        {
          "type": "regex",
          "path": "build.rs",
          "pattern": "const MAN_PAGE_DATE: &str = \"[^\"]+\";",
          "replacement": "const MAN_PAGE_DATE: &str = \"{{date}}\";"
        },
        {
          "type": "json",
          "path": "npm/panache-cli/package.json",
          "field-path": "$.version"
        },
        {
          "type": "json",
          "path": "npm/panache-cli/package.json",
          "field-path": "$.optionalDependencies.*"
        },
        {
          "type": "regex",
          "path": "flake.nix",
          "pattern": "version = \"(?<version>\\d+\\.\\d+\\.\\d+)\""
        }
      ]
    },
    "crates/panache-parser": {},
    "crates/panache-formatter": {},
    "editors/code": {
      "release-type": "node",
      "package-name": "panache-code",
      "follows": [
        "."
      ]
    },
    "editors/zed": {
      "package-name": "panache-zed",
      "extra-files": [
        {
          "type": "toml",
          "path": "extension.toml",
          "field-path": "$.version"
        },
        // `Cargo.lock` records the crate's own version, and nothing else keeps
        // it in step with `Cargo.toml`. The `--locked` build in CI is the
        // backstop if this rule ever stops matching.
        {
          "type": "regex",
          "path": "Cargo.lock",
          "pattern": "name = \"zed_panache\"\\nversion = \"([^\"]+)\""
        }
      ]
    }
  }
}
